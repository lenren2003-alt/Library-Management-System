@model List<OverdueLoanViewModel>

<div class="page-header">
    <h1 style="width: 100%; text-align: center;">Overdue Loans</h1>
    <a class="button" asp-action="Index">←</a>
</div>

@if (Model.Count == 0)
{
    <div class="empty">Nothing overdue right now. 🎉</div>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Book</th>
                <th>Member</th>
                <th>Loan Date</th>
                <th>Due Date</th>
                <th>Days Overdue</th>
                <th>Notify</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var loan in Model)
        {
            var subject = Uri.EscapeDataString("Overdue library book: " + loan.BookTitle);
            var body = Uri.EscapeDataString(
                $"Hi {loan.MemberName},\n\n" +
                $"The book \"{loan.BookTitle}\" was due back on {loan.DueDate:MMM d, yyyy} " +
                $"and is now {loan.DaysOverdue} day(s) overdue. Please return it as soon as you can.\n\n" +
                "Thanks,\nThe Library Team");

            <tr>
                <td>@loan.BookTitle</td>
                <td>@loan.MemberName</td>
                <td>@loan.LoanDate.ToShortDateString()</td>
                <td>@loan.DueDate.ToShortDateString()</td>
                <td>
                    <span class="overdue">@loan.DaysOverdue day@(loan.DaysOverdue == 1 ? "" : "s")</span>
                </td>
                <td>
                    <a class="small-button" href="mailto:@loan.MemberEmail?subject=@subject&body=@body">
                        Email Reminder
                    </a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
