@model Member
<div style="width: 450px; margin: 50px auto; padding: 30px; background: white; border-radius: 12px; box-shadow: 0 4px 15px rgba(0,0,0,0.15);">

    <h1 style="width: 100%; text-align: center;">Register a Member</h1>

<form asp-action="Create" method="post" class="form-card">
    <div asp-validation-summary="ModelOnly" class="validation"></div>

    <label asp-for="Name">Name</label>
    <input asp-for="Name" />
    <span asp-validation-for="Name" class="validation"></span>

    <label asp-for="Email">Email</label>
    <input asp-for="Email" type="email" />
    <span asp-validation-for="Email" class="validation"></span>

    <label asp-for="Phone">Phone</label>
    <input asp-for="Phone" />

    <button class="button" type="submit">Register Member</button>
    <a class="cancel" asp-action="Index">Cancel</a>
</form>
</div>
