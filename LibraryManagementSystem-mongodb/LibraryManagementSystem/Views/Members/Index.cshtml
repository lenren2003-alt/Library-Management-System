@model List<Member>

<div class="page-header">
    <h1 style="width: 100%; text-align: center;">Members</h1>
</div>

<form asp-action="Index" method="get" class="search">
    <input type="text" name="search" value="@ViewBag.Search"
           placeholder="Search by name or email..." />
    <button type="submit">Search</button>
</form>

@if (Model.Count == 0)
{
    <div class="empty">No members found.</div>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var member in Model)
        {
            <tr>
                <td>@member.Name</td>
                <td>@member.Email</td>
                <td>@member.Phone</td>
                <td>
                    <a class="small-button" asp-action="Edit" asp-route-id="@member.Id">Edit</a>
                    <a class="small-button danger" asp-action="Delete" asp-route-id="@member.Id">Delete</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
<br />
<a class="button" asp-action="Create">+ Register Member</a>

