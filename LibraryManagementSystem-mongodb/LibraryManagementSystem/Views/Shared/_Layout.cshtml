<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Library Management System</title>
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav>
        <div class="logo"> Library System</div>
        <a asp-controller="Home" asp-action="Index">Home</a>
        <a asp-controller="Books" asp-action="Index">Books</a>
        <a asp-controller="Members" asp-action="Index">Members</a>
        <a asp-controller="Loans" asp-action="Index">Loans</a>
        <a asp-controller="Reports" asp-action="Index">Reports</a>
    </nav>

    <main class="container">
        @if (TempData["Error"] != null)
        {
            <div class="alert">@TempData["Error"]</div>
        }

        @RenderBody()
    </main>
</body>
</html>
