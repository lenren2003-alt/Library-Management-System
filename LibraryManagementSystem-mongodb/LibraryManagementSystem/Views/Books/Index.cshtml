@model List<Book>

<div class="page-header">
    <h1 style="width: 100%; text-align: center;">Books</h1>
</div>

<form asp-action="Index" method="get" class="search">
    <input type="text" name="search" value="@ViewBag.Search"
           placeholder="Search by title, author or ISBN..." />
    <button type="submit">Search</button>
</form>

@if (Model.Count == 0)
{
    <div class="empty">No books found.</div>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Title</th>
                <th>Author</th>
                <th>ISBN</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var book in Model)
            {
                <tr>
                    <td>@book.Title</td>
                    <td>@book.Author</td>
                    <td>@book.ISBN</td>

                    <td>
                        @if (book.IsAvailable)
                        {
                            <span class="available">Available</span>
                        }
                        else
                        {
                            <span class="borrowed">Borrowed</span>
                        }
                    </td>

                    <td>
                        <a class="small-button"
                           asp-action="Edit"
                           asp-route-id="@book.Id">Edit</a>

                        <a class="small-button danger"
                           asp-action="Delete"
                           asp-route-id="@book.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<br />

<a class="button" asp-action="Create">+ Add Book</a>